# ===========================================
# AgentixBuddy Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For API keys see .env.secrets.example
# ===========================================

# Qdrant (leave empty for local Docker instance)
QDRANT_API_KEY=

# Langfuse Observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Vector DB Service
VECTOR_DB_COLLECTION=sample_bank_products
VECTOR_DB_HOST=0.0.0.0
VECTOR_DB_PORT=8004
# If running in docker, use: VECTOR_DB_URL=http://vector-db-service:8004
# For frontend, use: REACT_APP_VECTOR_DB_BASE=http://localhost:8004/vector_db_service

# ===========================================
# GKE Deployment Configuration (optional)
# ===========================================
# Override these to deploy to a different GCP project/region
# Defaults are used if not set

# GCP_PROJECT_ID=agentixbuddy-dev
# GCP_REGION=europe-west3
# GCP_REPO=agentixbuddy-repo
# K8S_NAMESPACE=agentixbuddy
# GKE_CLUSTER_NAME=agentixbuddy-cluster
