# ===========================================
# AgentixBuddy Secrets
# ===========================================
# Copy this file to .env.secrets and fill in your values:
#   cp .env.secrets.example .env.secrets
#
# Get your Google API key from: https://aistudio.google.com/apikey
# ===========================================

# Google Gemini API Keys (required for all AI agents)
GOOGLE_API_KEY=your-google-api-key-here
ORCHESTRATOR_GOOGLE_API_KEY=your-google-api-key-here
SERVICES_GOOGLE_API_KEY=your-google-api-key-here

# Qdrant (leave empty for local Docker instance)
QDRANT_API_KEY=

# Langfuse Observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=